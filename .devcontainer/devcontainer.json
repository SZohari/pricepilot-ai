{
  "name": "PricePilot Python 3.12",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {"vscode": {"extensions": ["ms-python.python", "ms-python.vscode-pylance"]}},
  "postCreateCommand": "python -m pip install -r requirements-dev.txt",
  "forwardPorts": [8000, 8501],
  "portsAttributes": {"8000": {"label": "PricePilot dashboard", "onAutoForward": "openPreview"}}
}
